# ==============================================================================
# GBFS Bike Sharing Operation Intelligence - Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.prod on your production server: cp .env.example .env.prod
# - Fill in strong, production-grade passwords and actual server IP or domain.
# - NEVER commit .env.prod or real secrets into version control (Git).
# - Inside Docker Compose, services MUST use container hostnames (postgres, redis),
#   NEVER use localhost (e.g. postgres:5432, redis:6379).
# ==============================================================================

# PostgreSQL Configuration (DO NOT publish port to public internet)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=bike_sharing

# App Database Connection URL (used by FastAPI and Airflow custom tasks)
# Format: postgresql+psycopg2://<user>:<password>@postgres:5432/<db>
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_postgres_password_here@postgres:5432/bike_sharing

# Redis Configuration (Used by FastAPI as optional query cache)
# Format: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Airflow Admin User & Process UID
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=your_secure_airflow_password_here
AIRFLOW_UID=50000

# GBFS Data Feeds Configuration
GBFS_BASE_URL=https://gbfs.lyft.com/gbfs/2.3/bkn/en
GBFS_LANGUAGE=en

# ------------------------------------------------------------------------------
# Deployment Mode Configuration (Direct Port vs Nginx Reverse Proxy)
# ------------------------------------------------------------------------------
# Mode A: Direct Port Demo (Default):
#   - Frontend on http://<server-ip>:3000
#   - FastAPI on http://<server-ip>:8000
#   - Airflow on http://<server-ip>:8080
#   - Set VITE_API_BASE_URL=http://<server-ip>:8000/api/v1
#
# Mode B: Nginx Reverse Proxy / HTTPS (Production-Like):
#   - All traffic routed through Port 80 (HTTP) or 443 (HTTPS)
#   - Set VITE_API_BASE_URL=/api/v1
# ------------------------------------------------------------------------------

# Service Port Mappings
FASTAPI_PORT=8000
FRONTEND_PORT=3000
AIRFLOW_WEBSERVER_PORT=8080

# Nginx Reverse Proxy Gateway Ports (Used with docker-compose.nginx.yml)
HTTP_PORT=80
HTTPS_PORT=443

# Public Domain / Hostname (for HTTPS Let's Encrypt setup)
PUBLIC_DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# CORS Allowed Origins for FastAPI (comma-separated origins or * for open demo)
# Example for Direct Port: http://localhost:3000,http://<server-ip>:3000
# Example for Nginx/HTTPS: http://<server-ip>,http://yourdomain.com,https://yourdomain.com
FRONTEND_ORIGINS=http://localhost:3000,http://<server-ip>:3000

# Vite Frontend API Base URL (Build-time variable baked into frontend bundle)
# Mode A (Direct Port): http://<server-ip>:8000/api/v1
# Mode B (Nginx/HTTPS): /api/v1
VITE_API_BASE_URL=/api/v1

# ==============================================================================
# Centralized Alerting & Telegram Bot Notification Configuration
# ==============================================================================
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_DEDUP_WINDOW_MINUTES=60
ALERT_REQUEST_TIMEOUT_SECONDS=10
